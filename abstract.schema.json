{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sfingali/film-universe-timelines-engine/abstract.schema.json",
  "title": "Abstract Universe Timeline",
  "description": "Pure, presentation-agnostic model of a multi-universe timeline. Contains no visual vocabulary (no glyphs, colours, lanes, dash-styles, density, timescale, or layout ordering). Visual forms are projections of this model.",
  "type": "object",
  "required": ["abstract_model", "title", "graphs"],
  "properties": {
    "abstract_model": { "const": "universe-timeline/1.0" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "footer": { "type": "string" },
    "profile": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "rules": { "type": ["string", "null"] },
        "params": { "type": "object", "additionalProperties": true }
      },
      "required": ["name"]
    },
    "sources": { "type": "array", "items": { "type": "object" } },
    "characters": { "type": "array", "items": { "type": "object", "required": ["id"] } },
    "travellers": { "type": "array", "items": { "type": "object", "required": ["id"] } },
    "namespaces": { "type": "array", "items": { "type": "object", "required": ["id"] } },
    "graphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/graph" } }
  },
  "$defs": {
    "cite": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "page": { "type": ["string", "null"] },
        "scene": { "type": ["string", "null"] },
        "locator": { "type": ["string", "null"] },
        "status": { "type": "string" }
      }
    },
    "graph": {
      "type": "object",
      "required": ["namespace", "worlds"],
      "properties": {
        "namespace": { "type": "string" },
        "title": { "type": "string" },
        "worlds": { "type": "array", "items": { "$ref": "#/$defs/world" } },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "segments": { "type": "array" },
        "beats": { "type": "array" },
        "splits": { "type": "array", "items": { "$ref": "#/$defs/split" } },
        "transfers": { "type": "array", "items": { "$ref": "#/$defs/transfer" } },
        "route": { "$ref": "#/$defs/route" },
        "fates": { "type": "array", "items": { "$ref": "#/$defs/fate" } },
        "merges": { "type": "integer" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "evidence": { "type": "array" }
      }
    },
    "world": {
      "type": "object",
      "required": ["id", "label", "origin"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "origin": { "enum": ["initial", "born", "preexisting", "unknown"] },
        "born": { "type": "object", "properties": { "event": { "type": "string" }, "parent": { "type": "string" }, "tine": { "type": "string" } } },
        "ancestry": { "type": "string" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "kind", "universe", "order", "label"],
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["start", "split", "outcome", "entry", "exit", "anchor", "cutoff", "gate_entry", "gate_exit"] },
        "universe": { "type": "string" },
        "order": { "type": ["integer", "null"] },
        "label": { "type": "string" },
        "cite": { "$ref": "#/$defs/cite" }
      }
    },
    "split": {
      "type": "object",
      "required": ["event", "outcomes"],
      "properties": {
        "event": { "type": "string" },
        "cause": { "type": "string" },
        "automatic": { "type": "boolean" },
        "traveller": { "type": "string" },
        "source_disposition": { "type": "string" },
        "source_universe": { "type": "string" },
        "outcomes": {
          "type": "object",
          "properties": {
            "+": { "$ref": "#/$defs/outcome" },
            "-": { "$ref": "#/$defs/outcome" }
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "properties": {
        "universe": { "type": "string" },
        "entry": { "type": "string" },
        "universe_outcome": { "type": "string" },
        "instances": { "type": "array", "items": { "type": "object" } }
      }
    },
    "transfer": {
      "type": "object",
      "required": ["id", "traveller"],
      "properties": {
        "id": { "type": "string" },
        "traveller": { "type": "string" },
        "from": { "type": "object", "properties": { "universe": { "type": "string" }, "exit": { "type": "string" } } },
        "to": { "type": "object", "properties": { "universe": { "type": "string" }, "entry": { "type": "string" } } },
        "mechanism": { "type": "string" },
        "relation": { "type": "object" }
      }
    },
    "route": {
      "type": "object",
      "properties": {
        "traveller": { "type": "string" },
        "visits": { "type": "array", "items": { "type": "object" } },
        "links": { "type": "array", "items": { "type": "object" } }
      }
    },
    "fate": {
      "type": "object",
      "required": ["id", "status"],
      "properties": {
        "id": { "type": "string" },
        "universe": { "type": "string" },
        "instance": { "type": "string" },
        "event": { "type": "string" },
        "status": { "enum": ["dead", "alive", "unknown", "nonexistent"] }
      }
    }
  }
}
